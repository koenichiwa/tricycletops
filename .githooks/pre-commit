#!/bin/sh
# Simple pre-commit hook for Tricycletops

set -e

# 1. Check Rust Firmware Formatting & Lints
if [ -d "tricycletops-fw" ]; then
    echo "Checking Rust firmware formatting..."
    (cd tricycletops-fw && cargo fmt --all -- --check)

    echo "Running Clippy lints on Rust firmware..."
    (cd tricycletops-fw && cargo clippy --all-targets -- -D warnings)
fi

# 2. Run Android App Lint Checks
if [ -d "tricycletops-app" ]; then
    echo "Running Android app lint checks..."
    (cd tricycletops-app && ./gradlew lint)
fi

echo "All checks passed!"
